rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in GoAbroad team member can read and edit projects.
    // Who is viewing right now: anyone on the team can read, each person writes only their own doc.
    match /presence/{uid} {
      allow read: if request.auth != null
        && request.auth.token.email.matches('.*@goabroad[.]com');
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /projects/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email.matches('.*@goabroad[.]com');
    }
  }
}
